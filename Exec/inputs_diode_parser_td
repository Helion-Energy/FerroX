#################################
###### PROBLEM DOMAIN ######
#################################

domain.prob_lo = -0.5e-6 -0.0625e-6 0.e-6
domain.prob_hi =  0.5e-6  0.0625e-6 1.0e-6

domain.n_cell = 64 4 64

domain.max_grid_size = 64 4 64
domain.blocking_factor = 64 4 64

domain.coord_sys = cartesian

prob_type = 1

TimeIntegratorOrder = 1

# Adjusted for reverse recovery time scales
nsteps = 5000000
plot_int = 50


# Smaller time step for transient accuracy
dt = 1.0e-14

phi_tolerance = 2.e-6
############################################
###### POLARIZATION BOUNDARY CONDITIONS ####
############################################

P_BC_flag_lo = 2 2 0
P_BC_flag_hi = 2 2 1
lambda = 3.0e-9

############################################
###### ELECTRICAL BOUNDARY CONDITIONS ######
############################################
mlmg_verbosity = 0

domain.is_periodic = 0 0 0

boundary.hi = neu neu dir(zmax)
boundary.lo = neu neu dir(zmin)

boundary.zmax_function = "if(t <= 10.0e-6, 0.7, if(t <= 10.005e-6, 0.7 - 5.7*(t-10.0e-6)/5.0e-9, -5.0))"  # Anode (time-dependent)
boundary.zmin_function = "0.0"

use_work_function = 1

use_Fermi_Dirac = 1

#################################
###### STACK GEOMETRY ###########
#################################

my_constants.n_type_xlo = -0.5e-6
my_constants.n_type_xhi =  0.5e-6
my_constants.n_type_ylo = -0.0625e-6
my_constants.n_type_yhi =  0.0625e-6
my_constants.n_type_zlo =  -0.01e-6
my_constants.n_type_zhi =  0.5e-6

my_constants.p_type_xlo = -0.5e-6
my_constants.p_type_xhi =  0.5e-6
my_constants.p_type_ylo = -0.0625e-6
my_constants.p_type_yhi =  0.0625e-6
my_constants.p_type_zlo =  0.5e-6
my_constants.p_type_zhi =  1.0e-6

# Material ID values
my_constants.n_type_val = 4.0
my_constants.p_type_val = 3.0
my_constants.de_val     = 1.0 # Default Dielectric value (from the final 'else' clause)

device_geom.device_geom_function(x,y,z) = "if((x >= n_type_xlo and x <= n_type_xhi and
                                               y >= n_type_ylo and y <= n_type_yhi and
                                               z >= n_type_zlo and z <= n_type_zhi), n_type_val,
                                           if((x >= p_type_xlo and x <= p_type_xhi and
                                               y >= p_type_ylo and y <= p_type_yhi and
                                               z > p_type_zlo and z <= p_type_zhi), p_type_val, de_val))"

#################################
###### MATERIAL PROPERTIES ######
#################################
Nc = 2.8e25
Nv = 1.83e25
bandgap = 1.12 #eV
affinity = 4.05 #eV
acceptor_doping = 1.0e22
donor_doping = 1.0e22
epsilon_0 = 8.85e-12
epsilon_de = 3.9
epsilon_si = 11.7
electron_mobility = 0.14 #m^2/V.s          
hole_mobility = 0.047 # m^2/V.s

#Recombination (Shockley-Read-Hall Model)
use_srh_recombination = 1
electron_lifetime = 1.0e-6 #s
hole_lifetime = 1.0e-6 #s

#Bandgap Narrowing (Slotboom Model)
use_bandgap_narrowing = 1

## Ferroelectric (unused when no FE layer is present) ##
epsilonX_fe = 24.0
epsilonZ_fe = 24.0
alpha = -2.5e9
beta = 6.0e10
gamma = 1.5e11
BigGamma = 100
g11 = 1.0e-9
g44 = 1.0e-9
g44_p = 0.0
g12 = 0.0
alpha_12 = 0.0
alpha_112 = 0.0
alpha_123 = 0.0

