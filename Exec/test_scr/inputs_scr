###### STACK GEOMETRY ###########
#################################

my_constants.p1_type_xlo = -0.5e-6
my_constants.p1_type_xhi =  0.5e-6
my_constants.p1_type_ylo = -0.0625e-6
my_constants.p1_type_yhi =  0.0625e-6
my_constants.p1_type_zlo = -1.0e-6
my_constants.p1_type_zhi = -0.5e-6

my_constants.n1_type_xlo = -0.5e-6
my_constants.n1_type_xhi =  0.5e-6
my_constants.n1_type_ylo = -0.0625e-6
my_constants.n1_type_yhi =  0.0625e-6
my_constants.n1_type_zlo = -0.5e-6
my_constants.n1_type_zhi =  0.0e-6

my_constants.p2_type_xlo = -0.5e-6
my_constants.p2_type_xhi =  0.5e-6
my_constants.p2_type_ylo = -0.0625e-6
my_constants.p2_type_yhi =  0.0625e-6
my_constants.p2_type_zlo =  0.0e-6
my_constants.p2_type_zhi =  0.5e-6

my_constants.n2_type_xlo = -0.5e-6
my_constants.n2_type_xhi = -0.25e-6
my_constants.n2_type_ylo = -0.0625e-6
my_constants.n2_type_yhi =  0.0625e-6
my_constants.n2_type_zlo =  0.5e-6
my_constants.n2_type_zhi =  1.0e-6

my_constants.n3_type_xlo =  0.25e-6
my_constants.n3_type_xhi =  0.5e-6
my_constants.n3_type_ylo = -0.0625e-6
my_constants.n3_type_yhi =  0.0625e-6
my_constants.n3_type_zlo =  0.5e-6
my_constants.n3_type_zhi =  1.0e-6

# Material ID values
my_constants.n_type_val = 4.0
my_constants.p_type_val = 3.0
my_constants.heavy_n_type_val = 6.0
my_constants.de_val     = 1.0 # Default Dielectric value (from the final 'else' clause)

device_geom.device_geom_function(x,y,z) = "if(((x >= n2_type_xlo and x <= n2_type_xhi and
                                                y >= n2_type_ylo and y <= n2_type_yhi and
                                                z >= n2_type_zlo and z <= n2_type_zhi) or
                                               (x >= n3_type_xlo and x <= n3_type_xhi and
                                                y >= n3_type_ylo and y <= n3_type_yhi and
                                                z >= n3_type_zlo and z <= n3_type_zhi)), heavy_n_type_val,
                                           if((x >= p1_type_xlo and x <= p1_type_xhi and
                                               y >= p1_type_ylo and y <= p1_type_yhi and
                                               z >= p1_type_zlo and z <= p1_type_zhi) or 
                                              (x >= p2_type_xlo and x <= p2_type_xhi and
                                               y >= p2_type_ylo and y <= p2_type_yhi and
                                               z >= p2_type_zlo and z <= p2_type_zhi), p_type_val,
                                           if((x >= n1_type_xlo and x <= n1_type_xhi and
                                               y >= n1_type_ylo and y <= n1_type_yhi and
                                               z >= n1_type_zlo and z <= n1_type_zhi), n_type_val, p_type_val)))"

