#################################
###### PROBLEM DOMAIN ######
#################################

domain.prob_lo = -0.5e-6 -0.0625e-6 -1.0e-6
domain.prob_hi =  0.5e-6  0.0625e-6  1.0e-6

domain.n_cell = 64 4 64

domain.max_grid_size = 64 4 64
domain.blocking_factor = 64 4 64

domain.coord_sys = cartesian 

prob_type = 1

TimeIntegratorOrder = 1

nsteps = 10000
plot_int = 100

dt = 4.0e-15
phi_tolerance = 2.e-6
############################################
###### POLARIZATION BOUNDARY CONDITIONS ####
############################################

P_BC_flag_lo = 2 2 0
P_BC_flag_hi = 2 2 1
lambda = 3.0e-9

############################################
###### ELECTRICAL BOUNDARY CONDITIONS ######
############################################
mlmg_verbosity = 0

domain.is_periodic = 0 0 0

boundary.hi = neu neu dir
boundary.lo = neu neu dir

#boundary.zmax_function = "0.5" 
Phi_Bc_lo = 0.0
Phi_Bc_hi = 0.0
use_work_function = 1

use_Fermi_Dirac = 1

voltage_sweep = 0
Phi_Bc_hi_max = 1.0
Phi_Bc_inc = 0.1
num_Vapp_max = 11

